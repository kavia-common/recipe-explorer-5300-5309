# Copy this file to .env and fill in your Supabase project credentials.
# Do NOT commit the actual .env file to source control.

# Public URL of this app (used for auth redirects); defaults to http://localhost:3000 if not set
REACT_APP_SITE_URL=http://localhost:3000

REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_KEY=YOUR-ANON-KEY
